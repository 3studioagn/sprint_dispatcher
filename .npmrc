auto-install-peers=true
strict-peer-dependencies=true
# shamefully-hoist=true necessário para electron-builder achar deps transitivas
# de jsdom/isomorphic-dompurify (tough-cookie, etc) ao empacotar o .asar.
# Sem isso, pnpm cria symlinks em .pnpm/ que electron-builder não navega
# e o app crasha em runtime com "Cannot find module 'tough-cookie'".
# Trade-off: phantom deps tornam-se possíveis (código pode importar packages
# não declarados no package.json). Aceito porque o foco é deployment.
shamefully-hoist=true
