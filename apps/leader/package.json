{
  "name": "sprint-leader",
  "version": "0.0.0",
  "private": true,
  "description": "Aplicação do Líder — Sprint Dispatcher",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "package": "pnpm build && electron-builder --dir",
    "make": "pnpm build && electron-builder",
    "make:portable": "pnpm build && electron-builder --win portable",
    "make:installer": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "@sprint/contracts": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^1.6.0"
  }
}
