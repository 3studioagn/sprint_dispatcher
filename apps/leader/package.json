{
  "name": "sprint-leader",
  "version": "0.0.0",
  "private": true,
  "description": "Aplicação do Líder — Sprint Dispatcher",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "package": "pnpm build && electron-builder --dir",
    "make": "pnpm build && electron-builder",
    "make:portable": "pnpm build && electron-builder --win portable",
    "make:installer": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "@sprint/contracts": "workspace:*",
    "@sprint/fs-adapter": "workspace:*",
    "@sprint/logger": "workspace:*",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.460.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.3",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.6.0",
    "electron": "^42.2.0",
    "electron-builder": "^24.0.0",
    "jsdom": "^24.0.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^1.6.0"
  }
}
