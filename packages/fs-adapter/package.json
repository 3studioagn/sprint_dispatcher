{
  "name": "@sprint/fs-adapter",
  "version": "0.0.0",
  "private": true,
  "description": "Filesystem adapter (port + Node + Memory) do Sprint Dispatcher",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "bin": {
    "sprint-archive-cleanup": "./dist/sprint-archive-cleanup.mjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "build:cli": "esbuild src/bin/sprint-archive-cleanup.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/sprint-archive-cleanup.mjs --external:zod --external:ulid --external:isomorphic-dompurify",
    "prepare": "pnpm run build:cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sprint/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "esbuild": "^0.21.5",
    "fast-check": "^3.20.0",
    "vitest": "^1.6.0"
  }
}
